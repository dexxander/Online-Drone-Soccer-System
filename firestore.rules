rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper Functions
    function isAuthenticated() {
      return request.auth != null;
    }
    
    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }
    
    function hasRole(role) {
      return isAuthenticated() && getUserData().role == role;
    }
    
    function isAdmin() {
      return hasRole('admin');
    }
    
    function isReferee() {
      return hasRole('referee');
    }
    
    function isCoach() {
      return hasRole('coach');
    }

    match /users/{userId} {
      // Users can read their own data; anyone logged in can read basic user info (for lists)
      allow read: if isAuthenticated();
      // Only admins can create/update roles, but users can update their own non-role fields
      allow create: if isAuthenticated() && request.auth.uid == userId;
      allow update: if isAuthenticated() && (request.auth.uid == userId || isAdmin());
      allow delete: if isAdmin();
    }
    
    match /teams/{teamId} {
      // Anyone can read teams
      allow read: if true;
      // Admins and Coaches can create/update teams
      allow create, update: if isAdmin() || isCoach();
      allow delete: if isAdmin();
    }
    
    match /players/{playerId} {
      allow read: if true;
      allow create, update: if isAdmin() || isCoach();
      allow delete: if isAdmin();
    }
    
    match /tournaments/{tournamentId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }
    
    match /matches/{matchId} {
      allow read: if true;
      // Admins and Referees can update match scores
      allow create, delete: if isAdmin();
      allow update: if isAdmin() || isReferee();
    }
    
    match /announcements/{announcementId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }
  }
}
